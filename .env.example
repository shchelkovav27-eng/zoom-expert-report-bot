# Скопируйте этот файл в .env и заполните. Значения ниже — плейсхолдеры.

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Необязательно: прокси для Bot API (например https://telegram-proxy.example.com/bot)
TELEGRAM_BASE_URL=
# Необязательно: в каких группах работать (id через запятую). Пусто — везде.
# Узнать id: добавить бота в группу и написать /chatid
ALLOWED_CHAT_IDS=

# --- Zoom (Server-to-Server OAuth app) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# E-mail пользователя Zoom, от чьего имени создаются встречи (пусто — me)
ZOOM_HOST=host@example.com
# cloud — запись в облако (платный тариф), local — на компьютер организатора
ZOOM_AUTO_RECORDING=cloud
# За сколько минут до начала можно войти без организатора (0, 5, 10, 15)
JOIN_BEFORE_MIN=15
# Записи короче этого (минуты) считаются случайным заходом и не обрабатываются
MIN_RECORDING_MIN=10

# --- Резервный аккаунт Zoom (второе приложение). Пусто — резерв выключен ---
ZOOM_BACKUP_ACCOUNT_ID=
ZOOM_BACKUP_CLIENT_ID=
ZOOM_BACKUP_CLIENT_SECRET=
ZOOM_BACKUP_HOST=backup-host@example.com
# 1 — убирать записи со второго аккаунта в корзину Zoom, 0 — не трогать
ZOOM_BACKUP_TRASH=0

# --- Организации программы (начало названия встречи) через точку с запятой ---
ORGANIZATIONS=НКО «Пример»;АНО «Пример-2»;Фонд «Пример-3»
# Эксперт каждой организации: «Организация=ФИО» через точку с запятой
EXPERTS=НКО «Пример»=Иванова Анна;АНО «Пример-2»=Петров Иван;Фонд «Пример-3»=Сидорова Мария

# --- Google Диск: общая папка «Встречи», в ней подпапки по организациям ---
GOOGLE_DRIVE_ROOT_ID=your-drive-folder-id
# Файл OAuth-входа в Google (client_id, client_secret, refresh_token). Пусто — google_token.json рядом с ботом
GOOGLE_TOKEN_FILE=

# --- Обработка записей ---
# Как часто проверять облако Zoom (минуты)
RECORDINGS_CHECK_MIN=10
# Окно просмотра облака Zoom (дни)
RECORDINGS_LOOKBACK_DAYS=14
# Через сколько дней после проверенной загрузки видео на Диск убирать запись в корзину Zoom (0 — не удалять)
ZOOM_TRASH_AFTER_DAYS=7
# Обрабатывать записи встреч, начавшихся не раньше этой даты (ГГГГ-ММ-ДД)
PROCESS_SINCE=2026-01-01

# Расшифровка (Transkriptor, api.tor.app)
TRANSCRIPTOR_API_KEY=
# Заполнение отчёта: Claude (Anthropic API)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
